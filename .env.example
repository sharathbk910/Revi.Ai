# ==============================================================================
# REVISIONLY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Public Configuration (Safe to expose to frontend)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Groq AI Secret API Key (MUST REMAIN SERVER-SIDE — NEVER COMMIT THIS KEY!)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=

# Server Port (Optional, defaults to 5173 for Vite dev / 3001 for standalone API)
PORT=5173
